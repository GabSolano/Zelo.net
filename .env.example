# ==============================================================================
# Zelo API (.NET 8) - Variáveis de Ambiente de Exemplo
# Copie para .env ou defina nas variáveis de ambiente do sistema / Azure DevOps
# NUNCA coloque credenciais reais versionadas no código.
# ==============================================================================

# Porta padrão do serviço zelo-cuidado conforme contrato do projeto
ASPNETCORE_URLS=http://+:5080
ASPNETCORE_ENVIRONMENT=Development

# Provedor de banco: "SqlServer", "Sqlite" (desenvolvimento local rápido) ou "InMemory"
DB_PROVIDER=Sqlite

# Connection string do banco (no Azure DevOps configurar como secret variable ConnectionStrings__Default)
ConnectionStrings__Default=Data Source=zelo_dev.db

# Segredo compartilhado com o serviço Java (zelo-monitor) para assinatura/validação JWT HS256 (mínimo 32 caracteres)
JWT_SECRET=PREENCHA_AQUI_O_JWT_SECRET_COMPARTILHADO_COM_JAVA_MIN_32_CHARS

# URL base do serviço Java (zelo-monitor) para Health Check externo e abertura de alerta R5
MONITOR_URL=http://localhost:8080

# Modo simulação (true = permite usar relógio simulado; false = usa relógio UTC do sistema)
MODO_SIMULACAO=true
