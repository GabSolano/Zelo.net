{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "zelo-cuidado",
    "Audience": "zelo-services",
    "ExpirationHours": 24
  },
  "MonitorService": {
    "BaseUrl": "http://localhost:8080"
  },
  "RateLimiting": {
    "GeneralPermitLimit": 60,
    "GeneralWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}
